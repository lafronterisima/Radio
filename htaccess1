Options -Indexes

RewriteEngine On
RewriteCond %{ENV:HTTPS} on [NC]
RewriteCond %{HTTP_HOST} lafronterisima\.stream$ [OR]
RewriteCond %{HTTP_HOST} www\.lafronterisima\.stream$
RewriteRule ^(.*)$ https://lafronterisima\.stream/$1 [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html?p=$1 [L]

DirectoryIndex "index.html"


