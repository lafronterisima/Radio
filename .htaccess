Options -Indexes

RewriteEngine On

# 🔒 Forzar HTTPS y dominio sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.lafronterisima\.stream$ [NC]
RewriteRule ^(.*)$ https://lafronterisima.stream/$1 [L,R=301]

# 📄 Redirigir .html a versión limpia (IMPORTANTE)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html [NC]
RewriteRule ^ %1 [L,R=301]

# 📄 Servir archivos .html sin mostrarlos en la URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

DirectoryIndex index.html
